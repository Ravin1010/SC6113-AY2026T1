flowchart TB
  U["User: Sender, Recipient or Admin"]
  subgraph CLIENT["USER / CLIENT — user-controlled browser and wallet"]
    direction TB
    B["Browser frontend: server-rendered HTML, CSS, vanilla JavaScript"]
    C["sessionStorage: scoped presentation snapshot; non-authoritative"]
    M["MetaMask: login signature; signs and submits transactions"]
    B --- C
    B <-->|"wallet requests / signature / hash"| M
  end
  subgraph HOST["HOSTING — existing Render Python service"]
    direction TB
    F["Flask application and REST APIs"]
    A["Wallet-signature authentication / session validation"]
    V["Verified reads; unsigned preparation; receipt verification / post-state reads"]
    F --- A
    F --- V
  end
  subgraph DB["PERSISTENCE — application support, NOT financial authority"]
    direction LR
    L["Local / development: SQLite"]
    T["Production: Turso / libSQL"]
  end
  subgraph CHAIN["ETHEREUM SEPOLIA — financial authority"]
    direction LR
    R["RoleRegistry: roles / pause"]
    D["deposit_money: balances / reservations / payouts"]
    P["paynow / transfer_money: remittance state"]
  end
  U --> B
  B <-->|"HTTPS pages / REST"| F
  F -->|"Application support / indexed Activity"| DB
  V <-->|"RPC: pinned reads / simulation / receipt checks"| CHAIN
  M -->|"User-approved signed transaction"| CHAIN
